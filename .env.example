# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://movie:movie@localhost:5433/movie_memory?schema=public"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
# Needed for `next start` locally; behind a real domain set AUTH_URL instead
AUTH_TRUST_HOST=true

# Google OAuth client (redirect URI: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
